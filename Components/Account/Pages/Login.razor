@page "/Account/Login"
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Agencia.Web.Data
@inject SignInManager<ApplicationUser> SignIn
@inject IdentityRedirectManager Redirect
<PageTitle>@L["Entrar"] | Terra Andina</PageTitle>
<section class="wrap section account">
    <h1>@L["Entrar"]</h1>
    @if (error is not null) { <p class="notice error" role="alert">@error</p> }
    <EditForm class="panel form-stack" Model="Input" method="post" FormName="login" OnValidSubmit="LoginAccount">
        <DataAnnotationsValidator /><ValidationSummary />
        <label>@T("Correo", "Email")<InputText type="email" autocomplete="username" @bind-Value="Input!.Email" /></label>
        <label>@T("Contraseña", "Password")<InputText type="password" autocomplete="current-password" @bind-Value="Input!.Password" /></label>
        <label class="check"><InputCheckbox @bind-Value="Input!.Recordar" />@T("Mantener mi sesión", "Keep me signed in")</label>
        <button class="btn" type="submit">@L["Entrar"]</button>
    </EditForm>
    <p><a class="text-link" href="@($"/Account/Register?ReturnUrl={Uri.EscapeDataString(Destino)}")">@T("Crear cuenta", "Create account")</a></p>
</section>
@code {
    [SupplyParameterFromForm] private InputModel? Input { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    private string? error;
    private string Destino => Preferences.LocalPath(ReturnUrl ?? "/panel");
    protected override void OnInitialized() => Input ??= new();
    private async Task LoginAccount()
    {
        var result = await SignIn.PasswordSignInAsync(Input!.Email.Trim(), Input.Password, Input.Recordar, lockoutOnFailure: true);
        if (result.Succeeded) Redirect.RedirectTo(Destino);
        else if (result.RequiresTwoFactor) Redirect.RedirectTo("Account/LoginWith2fa", new() { ["returnUrl"] = Destino, ["rememberMe"] = Input.Recordar });
        else error = T("Revisa tus credenciales o inténtalo más tarde.", "Check your credentials or try again later.");
    }
    private sealed class InputModel
    {
        [Required, EmailAddress, MaxLength(250)] public string Email { get; set; } = "";
        [Required, MaxLength(100)] public string Password { get; set; } = "";
        public bool Recordar { get; set; }
    }
}
