@page "/tours"
@attribute [StreamRendering]
@inject ITourService ToursService
@inject IDestinationService DestinosService
@inject Preferences SitePreferences

<PageTitle>@L["Tours"] | Terra Andina</PageTitle>
<HeadContent><meta name="description" content="@T("Busca tours y salidas en Bolivia por fecha, destino, tipo y precio.", "Find Bolivia tours by date, destination, type and price.")" /></HeadContent>
<section class="intro"><div class="wrap"><p class="eyebrow">BOLIVIA</p><h1>@T("Encuentra tu próxima ruta", "Find your next route")</h1><p>@T("Explora los itinerarios y elige una salida con cupos.", "Explore itineraries and choose an available departure.")</p></div></section>
<section class="wrap section">
    <form method="get" action="/tours" class="panel filters">
        <label>@T("Buscar", "Search")<input name="buscar" value="@Buscar" maxlength="100" /></label>
        <label>@T("Región", "Region")<select name="region"><option value="">@T("Todas", "All")</option>@foreach (var opcion in regiones) { <option value="@opcion.Id" selected="@(Region == opcion.Id)">@T(opcion.Nombre, opcion.NombreEn)</option> }</select></label>
        <label>@T("Tipo", "Type")<select name="tipo"><option value="">@T("Todos", "All")</option>@foreach (var opcion in Enum.GetValues<TipoTour>()) { <option value="@((int)opcion)" selected="@(Tipo == (int)opcion)">@LocalEnum.Show(opcion)</option> }</select></label>
        <label>@T("Dificultad", "Difficulty")<select name="nivel"><option value="">@T("Todas", "All")</option>@foreach (var opcion in Enum.GetValues<Dificultad>()) { <option value="@((int)opcion)" selected="@(Nivel == (int)opcion)">@LocalEnum.Show(opcion)</option> }</select></label>
        <label>@T("Días máximos", "Maximum days")<input type="number" name="dias" min="1" max="60" value="@Dias" /></label>
        <label>@T("Precio máximo", "Maximum price") (@SitePreferences.Currency)<input type="number" name="maximo" min="0" step="0.01" value="@Maximo?.ToString(CultureInfo.InvariantCulture)" /></label>
        <label>@T("Fecha de salida", "Departure date")<input type="date" name="fecha" value="@Fecha?.ToString("yyyy-MM-dd")" /></label>
        <div class="actions flex flex-wrap items-center gap-3"><button class="btn" type="submit">@T("Filtrar", "Filter")</button><a class="text-link" href="/tours">@T("Limpiar", "Clear")</a></div>
    </form>
    @if (resultados is null) { <p role="status">@T("Cargando tours…", "Loading tours…")</p> }
    else if (resultados.Count == 0) { <p class="empty">@T("No encontramos tours con esos filtros.", "No tours match those filters.")</p> }
    else
    {
        <p class="muted">@resultados.Count @(resultados.Count == 1 ? "tour" : "tours")</p>
        <div class="card-grid">@foreach (var tour in resultados) { <TourCard Tour="tour" /> }</div>
    }
</section>
@code {
    [SupplyParameterFromQuery] public string? Buscar { get; set; }
    [SupplyParameterFromQuery] public int? Region { get; set; }
    [SupplyParameterFromQuery] public int? Destino { get; set; }
    [SupplyParameterFromQuery] public int? Tipo { get; set; }
    [SupplyParameterFromQuery] public int? Nivel { get; set; }
    [SupplyParameterFromQuery] public int? Dias { get; set; }
    [SupplyParameterFromQuery] public decimal? Maximo { get; set; }
    [SupplyParameterFromQuery] public DateOnly? Fecha { get; set; }
    private List<Region> regiones = [];
    private List<Tour>? resultados;
    protected override async Task OnParametersSetAsync()
    {
        regiones = await DestinosService.Regiones();
        resultados = await ToursService.Buscar(new(Region, (TipoTour?)Tipo, (Dificultad?)Nivel, Dias, Maximo, Fecha, SitePreferences.Currency, Buscar, Destino));
    }
}
