@page "/gestion/catalogo/{Clave}"
@layout PanelLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = Acceso.Operativo)]
@inject AdminService Admin
@inject ICurrentUserService Current
@inject NavigationManager Nav

<PageTitle>@modulo?.Titulo | Terra Andina</PageTitle>
<h1>@(modulo?.Titulo ?? "Gestión de registros")</h1>
@if (mensaje is not null) { <p class="notice @(error ? "error" : "")" role="status">@mensaje</p> }
@if (modulo is { } m)
{
    <div class="toolbar">
        <label>Buscar<input type="search" @bind="busqueda" @bind:event="oninput" /></label>
        @if (!m.SoloEditar) { <button class="btn" disabled="@busy" @onclick="Nuevo">Nuevo registro</button> }
    </div>
    @if (editando is not null)
    {
        <form class="panel form-stack" @onsubmit="Guardar" @onsubmit:preventDefault>
            <h2>@(editando.Id == 0 ? "Nuevo registro" : $"Editar registro #{editando.Id}")</h2>
            <fieldset class="field-grid" disabled="@busy">
                @foreach (var c in campos)
                {
                    if (c.Tipo == typeof(bool))
                    {
                        <label class="check"><input type="checkbox" checked="@(valores[c.Clave] == "true")" @onchange="e => valores[c.Clave] = ((bool)e.Value!).ToString().ToLowerInvariant()" />@Etiqueta(c.Titulo)</label>
                    }
                    else
                    {
                        <label>@Etiqueta(c.Titulo)
                            @if (c.Opciones is not null)
                            {
                                <select @bind="valores[c.Clave]" required="@(!c.Opcional)"><option value="">Selecciona una opción</option>
                                    @foreach (var o in c.Opciones) { <option value="@o.Id">@o.Texto</option> }
                                </select>
                            }
                            else if (c.Tipo.IsEnum)
                            {
                                <select @bind="valores[c.Clave]">@foreach (var opcion in Enum.GetValues(c.Tipo)) { <option value="@opcion">@LocalEnum.Show((Enum)opcion)</option> }</select>
                            }
                            else if (c.Largo && c.Clave != "Imagen")
                            {
                                <textarea rows="3" @bind="valores[c.Clave]"></textarea>
                            }
                            else
                            {
                                <input type="@(c.Tipo == typeof(DateOnly) ? "date" : "text")" value="@valores[c.Clave]" @onchange="e => valores[c.Clave] = e.Value?.ToString() ?? string.Empty" />
                            }
                        </label>
                    }
                }
            </fieldset>
            <div class="actions"><button class="btn" type="submit" disabled="@busy">Guardar</button><button class="btn btn-outline" type="button" disabled="@busy" @onclick="() => editando = null">Cerrar</button></div>
        </form>
    }
    @if (Bandeja.Count == 0) { <p class="empty">No hay registros para mostrar.</p> }
    else
    {
        <div class="table-wrap"><table>
            <thead><tr><th>ID</th>@foreach (var c in columnas) { <th>@Etiqueta(c.Titulo)</th> }<th>Acciones</th></tr></thead>
            <tbody>@foreach (var r in Bandeja)
            {
                <tr @key="r.Id"><td>@r.Id</td>
                    @foreach (var c in columnas)
                    {
                        <td>
                            @AdminService.Texto(c, r)
                            @if (c.Clave == "Hasta" && r is Convenio { Activo: true } v && v.Hasta >= Hoy && v.Hasta <= Hoy.AddDays(30))
                            { <span class="status warning">Por vencer</span> }
                        </td>
                    }
                    <td class="table-actions">
                        @if (r is Cliente) { <a class="text-link" href="/gestion/clientes/@r.Id">Historial</a> }
                        <button type="button" class="btn btn-outline btn-small" disabled="@busy" @onclick="() => Editar(r)">Editar</button>
                        @if (!m.SoloEditar)
                        {
                            @if (eliminarId == r.Id)
                            {
                                <button class="btn danger btn-small" disabled="@busy" @onclick="() => Eliminar(r.Id)">Confirmar</button>
                                <button class="btn btn-outline btn-small" @onclick="() => eliminarId = null">Cancelar</button>
                            }
                            else { <button class="btn btn-outline btn-small" disabled="@busy" @onclick="() => eliminarId = r.Id">Eliminar</button> }
                        }
                    </td></tr>
            }</tbody>
        </table></div>
    }
}
@code {
    [Parameter] public string Clave { get; set; } = "";
    private Modulo? modulo;
    private IRegistro? editando;
    private List<IRegistro> filas = [];
    private List<Campo> campos = [], columnas = [];
    private Dictionary<string, string> valores = [];
    private int? eliminarId;
    private string busqueda = "";
    private string? mensaje;
    private bool busy, error;
    private List<IRegistro> Bandeja => string.IsNullOrWhiteSpace(busqueda) ? filas :
        filas.Where(r => columnas.Any(c => AdminService.Texto(c, r).Contains(busqueda, StringComparison.CurrentCultureIgnoreCase))).ToList();
    protected override async Task OnParametersSetAsync()
    {
        editando = null;
        eliminarId = null;
        mensaje = null;
        busqueda = "";
        modulo = AdminService.Modulos.SingleOrDefault(x => x.Clave == Clave);
        if (modulo is null) { Nav.NotFound(); return; }
        var actor = await Current.Actual();
        if (actor is null || !modulo.Permisos.Any(actor.Tiene)) { modulo = null; Nav.NavigateTo("/Account/AccessDenied"); return; }
        await Cargar();
    }
    private static string Etiqueta(string campo) => System.Text.RegularExpressions.Regex.Replace(campo, "(?<=[a-z])(?=[A-Z])", " ");
    private async Task Cargar() => (filas, campos, columnas) = await Admin.Abrir(Clave);
    private void Nuevo() => Editar((IRegistro)Activator.CreateInstance(modulo!.Tipo)!);
    private void Editar(IRegistro registro)
    {
        editando = registro;
        valores = campos.ToDictionary(c => c.Clave, c => AdminService.Valor(c.Propiedad, registro));
        mensaje = null;
    }
    private Task Guardar() => Ejecutar(async () =>
    {
        if (editando is null) return;
        await Admin.Guardar(Clave, editando.Id, valores, (editando as Salida)?.Version);
        editando = null;
    }, "Registro guardado.");
    private Task Eliminar(int id) => Ejecutar(async () =>
    {
        await Admin.Eliminar(Clave, id);
        eliminarId = null;
        if (editando?.Id == id) editando = null;
    }, "Registro eliminado.");
    private async Task Ejecutar(Func<Task> action, string ok)
    {
        if (busy) return;
        busy = true;
        mensaje = null;
        error = false;
        try { await action(); await Cargar(); mensaje = ok; }
        catch (ReglaException ex) { mensaje = ex.Message; error = true; }
        catch (UnauthorizedAccessException) { Nav.NavigateTo("/Account/AccessDenied"); }
        finally { busy = false; }
    }
}
