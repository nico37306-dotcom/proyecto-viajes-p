@page "/mis-reservas"
@page "/gestion/reservas"
@page "/gestion/pagos"
@layout PanelLayout
@attribute [Authorize]
@inject IBookingService Service
@inject ICurrentUserService Current
@inject NavigationManager Nav
<PageTitle>@titulo | Terra Andina</PageTitle>
<h1>@titulo</h1>
@if (reservas.Count == 0) { <p class="empty">@T("Aún no hay reservas para mostrar.", "There are no bookings to show.")</p> }
else
{
    <div class="table-wrap"><table><thead><tr><th>@T("Reserva", "Booking")</th><th>@L["Tours"]</th><th>@T("Salida", "Departure")</th>
        @if (staff) { <th>Cliente</th> }
        <th>@T("Pasajeros", "Guests")</th><th>@T("Estado", "Status")</th><th>@T("Saldo", "Balance")</th></tr></thead><tbody>
        @foreach (var r in reservas)
        {
            <tr><td><a class="text-link" href="/reservas/@r.Id">#@r.Id</a></td><td>@T(r.Salida.Tour.Nombre, r.Salida.Tour.NombreEn)</td>
                <td>@r.Salida.Inicio.ToString("d")</td>
                @if (staff) { <td>@(r.Cliente?.Nombre ?? r.Organizacion?.Nombre)</td> }
                <td>@r.Cantidad</td><td><span class="status">@LocalEnum.Show(r.Estado)</span></td>
                <td>@Preferences.Money(r.Total-r.Pagado,r.Moneda)</td></tr>
        }
    </tbody></table></div>
}
@code {
    private bool staff;
    private string titulo = "";
    private List<Reserva> reservas = [];
    protected override async Task OnParametersSetAsync()
    {
        var ruta = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0];
        staff = ruta != "mis-reservas";
        var actor = await Current.Actual();
        var permiso = ruta == "gestion/pagos" ? Acceso.Contabilidad : staff ? Acceso.Ventas : Acceso.Viajero;
        titulo = ruta == "gestion/pagos" ? "Pagos por reserva" : staff ? "Bandeja de reservas" : T("Mis reservas", "My bookings");
        if (actor?.Tiene(permiso) != true) { Nav.NavigateTo("/Account/AccessDenied"); return; }
        reservas = await Service.Listar(staff);
    }
}
